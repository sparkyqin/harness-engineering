{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["core/*"],
      "@templates/*": ["templates/*"]
    }
  },
  "include": ["core/**/*.ts", "core/**/*.js", "app/**/*.ts", "app/**/*.tsx"],
  "exclude": ["node_modules", "templates"]
}
